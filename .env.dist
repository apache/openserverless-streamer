# github user, used to derive the default local image name
GITHUB_USER=github: put here your github user

# full image name WITHOUT the tag (registry/namespace/repository).
# Overrides the default taken from ARG STREAMER_IMAGE_DEFAULT in the Dockerfile.
MY_STREAMER_IMAGE=ghcr.io/${GITHUB_USER}/openserverless-streamer

# for task docker-login-ghcr (github)
GITHUB_TOKEN=

# for task docker-login-dockerhub (dockerhub)
DOCKERHUB_TOKEN=
DOCKERHUB_USER=

# used to run the streamer locally
OW_APIHOST=
STREAMER_ADDR=
HTTP_SERVER_PORT=
